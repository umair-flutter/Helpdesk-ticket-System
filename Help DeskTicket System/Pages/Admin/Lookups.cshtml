@page
@model Help_DeskTicket_System.Pages.Admin.LookupsModel
@{
    ViewData["Title"] = L["Statuses & lists"].Value;
    var tabs = new[] { ("statuses", "Statuses"), ("priorities", "Priorities & SLA"), ("departments", "Departments"), ("categories", "Categories") };
    IHtmlContent Check(string name, bool on, string label) => new HtmlString(
        $"<div class=\"form-check form-check-inline mb-0\"><input class=\"form-check-input\" type=\"checkbox\" name=\"{name}\" value=\"true\" {(on ? "checked" : "")}><input type=\"hidden\" name=\"{name}\" value=\"false\"><label class=\"form-check-label small\">{System.Net.WebUtility.HtmlEncode(Lang.T(label))}</label></div>");
}
<h1 class="h4 mb-3">Statuses &amp; lists</h1>
<ul class="nav nav-tabs mb-3">
    @foreach (var (key, label) in tabs)
    {
        <li class="nav-item"><a class="nav-link @(Model.Tab == key ? "active" : "")" asp-route-tab="@key">@L[label]</a></li>
    }
</ul>

@if (Model.Tab == "statuses")
{
    <p class="small text-muted">@L["\"Closed\" statuses stop the SLA clock and count as resolved. The default status is given to new tickets."]</p>
    @foreach (var s in Model.Statuses.Append(new TicketStatus { SortOrder = Model.Statuses.Count + 1 }))
    {
        <form method="post" asp-page-handler="Status" class="card card-body py-2 mb-2">
            <input type="hidden" name="Id" value="@s.Id" />
            <div class="row g-2 align-items-center">
                <div class="col-md-3"><input class="form-control form-control-sm" name="Name" value="@s.Name" placeholder="@L["New status name"]" required /></div>
                <div class="col-4 col-md-1"><input class="form-control form-control-sm form-control-color w-100" type="color" name="Color" value="@s.Color" title="@L["Color"]" /></div>
                <div class="col-4 col-md-1"><input class="form-control form-control-sm" type="number" name="SortOrder" value="@s.SortOrder" title="@L["Order"]" /></div>
                <div class="col-md-4">@Check("IsDefault", s.IsDefault, "Default") @Check("IsClosed", s.IsClosed, "Closed")</div>
                <div class="col-md-3 text-md-end">
                    <button class="btn btn-sm btn-primary">@(s.Id == 0 ? L["Add"] : L["Save"])</button>
                    @if (s.Id != 0) { <button class="btn btn-sm btn-outline-danger" asp-page-handler="Delete" asp-route-kind="status" asp-route-id="@s.Id" formnovalidate data-confirm="@L["Delete status?"]"><i class="bi bi-trash"></i></button> }
                </div>
            </div>
        </form>
    }
}
else if (Model.Tab == "priorities")
{
    <p class="small text-muted">@L["SLA hours define when the first reply and the resolution are due for tickets of each priority. Overdue tickets are flagged and admins are notified."]</p>
    <div class="row g-2 small text-muted d-none d-md-flex px-3"><div class="col-md-3">@L["Name"]</div><div class="col-md-1">@L["Color"]</div><div class="col-md-1">@L["Order"]</div><div class="col-md-2">@L["First reply (h)"]</div><div class="col-md-2">@L["Resolve (h)"]</div></div>
    @foreach (var p in Model.Priorities.Append(new Priority { SortOrder = Model.Priorities.Count + 1 }))
    {
        <form method="post" asp-page-handler="Priority" class="card card-body py-2 mb-2">
            <input type="hidden" name="Id" value="@p.Id" />
            <div class="row g-2 align-items-center">
                <div class="col-md-3"><input class="form-control form-control-sm" name="Name" value="@p.Name" placeholder="@L["New priority"]" required /></div>
                <div class="col-4 col-md-1"><input class="form-control form-control-sm form-control-color w-100" type="color" name="Color" value="@p.Color" /></div>
                <div class="col-4 col-md-1"><input class="form-control form-control-sm" type="number" name="SortOrder" value="@p.SortOrder" /></div>
                <div class="col-6 col-md-2"><input class="form-control form-control-sm" type="number" min="1" name="SlaResponseHours" value="@p.SlaResponseHours" title="@L["First reply due (hours)"]" /></div>
                <div class="col-6 col-md-2"><input class="form-control form-control-sm" type="number" min="1" name="SlaResolveHours" value="@p.SlaResolveHours" title="@L["Resolve due (hours)"]" /></div>
                <div class="col-md-1">@Check("IsDefault", p.IsDefault, "Default")</div>
                <div class="col-md-2 text-md-end">
                    <button class="btn btn-sm btn-primary">@(p.Id == 0 ? L["Add"] : L["Save"])</button>
                    @if (p.Id != 0) { <button class="btn btn-sm btn-outline-danger" asp-page-handler="Delete" asp-route-kind="priority" asp-route-id="@p.Id" formnovalidate data-confirm="@L["Delete priority?"]"><i class="bi bi-trash"></i></button> }
                </div>
            </div>
        </form>
    }
}
else if (Model.Tab == "departments")
{
    @foreach (var d in Model.Departments.Append(new Department()))
    {
        <form method="post" asp-page-handler="Department" class="card card-body py-2 mb-2">
            <input type="hidden" name="Id" value="@d.Id" />
            <div class="row g-2 align-items-center">
                <div class="col-md-3"><input class="form-control form-control-sm" name="Name" value="@d.Name" placeholder="@L["New department"]" required /></div>
                <div class="col-md-5"><input class="form-control form-control-sm" name="Description" value="@d.Description" placeholder="@L["Description"]" /></div>
                <div class="col-md-2">@Check("IsActive", d.IsActive, "Active")</div>
                <div class="col-md-2 text-md-end">
                    <button class="btn btn-sm btn-primary">@(d.Id == 0 ? L["Add"] : L["Save"])</button>
                    @if (d.Id != 0) { <button class="btn btn-sm btn-outline-danger" asp-page-handler="Delete" asp-route-kind="department" asp-route-id="@d.Id" formnovalidate data-confirm="@L["Delete department? Tickets keep existing but lose this department."]"><i class="bi bi-trash"></i></button> }
                </div>
            </div>
        </form>
    }
}
else
{
    @foreach (var c in Model.Categories.Append(new Category()))
    {
        <form method="post" asp-page-handler="Category" class="card card-body py-2 mb-2">
            <input type="hidden" name="Id" value="@c.Id" />
            <div class="row g-2 align-items-center">
                <div class="col-md-4"><input class="form-control form-control-sm" name="Name" value="@c.Name" placeholder="@L["New category"]" required /></div>
                <div class="col-md-4">
                    <select class="form-select form-select-sm" name="DepartmentId"><option value="">@L["Any department"]</option>
                        @foreach (var d in Model.Departments) { <option value="@d.Id" selected="@(d.Id == c.DepartmentId)">@d.Name</option> }
                    </select>
                </div>
                <div class="col-md-2">@Check("IsActive", c.IsActive, "Active")</div>
                <div class="col-md-2 text-md-end">
                    <button class="btn btn-sm btn-primary">@(c.Id == 0 ? L["Add"] : L["Save"])</button>
                    @if (c.Id != 0) { <button class="btn btn-sm btn-outline-danger" asp-page-handler="Delete" asp-route-kind="category" asp-route-id="@c.Id" formnovalidate data-confirm="@L["Delete category?"]"><i class="bi bi-trash"></i></button> }
                </div>
            </div>
        </form>
    }
}
