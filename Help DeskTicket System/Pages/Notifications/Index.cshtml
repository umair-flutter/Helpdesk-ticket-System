@page
@model Help_DeskTicket_System.Pages.Notifications.IndexModel
@{ ViewData["Title"] = L["Notifications"].Value; }
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0">@L["Notifications"]</h1>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="ReadAll"><button class="btn btn-sm btn-outline-secondary">@L["Mark all read"]</button></form>
        <form method="post" asp-page-handler="Clear"><button class="btn btn-sm btn-outline-danger">@L["Clear read"]</button></form>
    </div>
</div>
<div class="card">
    <div class="list-group list-group-flush">
        @foreach (var n in Model.Items)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between gap-2 @(n.IsRead ? "" : "fw-semibold")" asp-page-handler="Open" asp-route-id="@n.Id">
                <span>@if (!n.IsRead) { <span class="badge text-bg-primary me-1">@L["new"]</span> }@n.Message</span>
                <span class="small text-muted text-nowrap">@Ui.Ago(n.CreatedAt)</span>
            </a>
        }
        @if (!Model.Items.Any()) { <div class="p-4 text-center text-muted">@L["You're all caught up."]</div> }
    </div>
</div>
