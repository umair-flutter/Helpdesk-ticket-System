@page
@model Help_DeskTicket_System.Pages.Kb.IndexModel
@{ ViewData["Title"] = L["Knowledge base"].Value; }
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0">@L["Knowledge base"]</h1>
    @if (User.IsStaff()) { <a class="btn btn-primary" asp-page="Edit"><i class="bi bi-plus-lg"></i> @L["New article"]</a> }
</div>
<form method="get" class="mb-3">
    <div class="input-group input-group-lg">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input class="form-control" name="q" value="@Model.Q" placeholder="@L["Search for answers…"]" />
    </div>
</form>
@if (Model.Categories.Any())
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-sm @(Model.CategoryId is null ? "btn-primary" : "btn-outline-secondary")" asp-page="Index" asp-route-q="@Model.Q">@L["All"]</a>
        @foreach (var c in Model.Categories)
        {
            <a class="btn btn-sm @(Model.CategoryId == c.Id ? "btn-primary" : "btn-outline-secondary")" asp-page="Index" asp-route-categoryId="@c.Id" asp-route-q="@Model.Q">@c.Name</a>
        }
    </div>
}
<div class="row g-3">
    @foreach (var a in Model.Articles)
    {
        <div class="col-md-6 col-xl-4">
            <a class="card card-body h-100 text-decoration-none" asp-page="Article" asp-route-id="@a.Id">
                <h2 class="h6 mb-1">@a.Title @if (!a.IsPublished) { <span class="badge text-bg-secondary">@L["Draft"]</span> }</h2>
                <p class="small text-muted mb-2">@(a.Body.Length > 140 ? a.Body[..140].Replace("**", "") + "…" : a.Body.Replace("**", ""))</p>
                <div class="small text-muted mt-auto">@(a.Category?.Name ?? L["General"].Value) · @L["{0} views", a.Views]</div>
            </a>
        </div>
    }
</div>
@if (!Model.Articles.Any())
{
    <div class="text-center text-muted py-5">
        @L["No articles found."]
        @if (User.Identity?.IsAuthenticated == true) { <div class="mt-2"><a class="btn btn-primary" asp-page="/Tickets/Create">@L["Open a ticket instead"]</a></div> }
    </div>
}
